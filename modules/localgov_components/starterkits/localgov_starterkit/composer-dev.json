{
    "name": "drupal/localgov_starterkit_dev",
    "description": "Composer-based development tools",
    "type": "metapackage",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Drupal\\Core\\Template\\": "../../../core/lib/Drupal/Core/Template"
        }
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "vincentlanglet/twig-cs-fixer": "^3.10"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
